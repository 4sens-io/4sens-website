---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://4sens.io/#organization",
      "name": "4sens Agency",
      "url": "https://4sens.io",
      "logo": "https://4sens.io/favicon.svg",
      "email": "erik@4sens.io",
      "foundingDate": "2020",
      "description": "Agencia Shopify Partner especializada en desarrollo, CRO, growth y migraciones.",
      "address": { "@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES" },
      "sameAs": ["https://linkedin.com/company/4sens"]
    },
    {
      "@type": "WebSite",
      "@id": "https://4sens.io/#website",
      "url": "https://4sens.io",
      "name": "4sens Agency",
      "publisher": { "@id": "https://4sens.io/#organization" }
    }
  ]
};
---

<BaseLayout
  title="4sens Agency — Shopify Partner | Desarrollo, CRO & Growth"
  description="Agencia Shopify Partner especializada en desarrollo a medida, consultoría CRO y growth. +120 proyectos lanzados. +€40M GMV generado para nuestros clientes."
  hasParticles={true}
  hasInteractions={true}
  schema={schema}
>
  <!-- HERO -->
  <div class="hero">
    <canvas id="particles"></canvas>
    <div class="vig"></div>
    <div class="hinner wrap">
      <div class="hcol">
        <div class="hbadge">Shopify Partners <span style="opacity:.4">·</span> +120 proyectos lanzados</div>
        <h1>Tiendas Shopify que <em class="em">venden</em>.</h1>
        <p class="hsub">Desarrollo experto. Estrategia 360. Growth medible. Sin floreos — solo el trabajo que mueve la P&amp;L.</p>
        <div class="hctas">
          <a class="btn btn-p" href="/casos">Ver nuestro trabajo <span class="arr">→</span></a>
          <a class="btn btn-g" href="/contacto">Hablar con un experto</a>
        </div>
        <span class="htag">where commerce meets craft — est. 2020</span>
      </div>
      <div class="hvis" id="hvis">
        <div class="orb"></div><div class="orb b"></div><div class="orb c"></div>
        <div class="cube">
          <div class="fc fz">4s</div><div class="fc fzb">4s</div>
          <div class="fc fx">4s</div><div class="fc fy">4s</div>
          <div class="fc ft">4s</div><div class="fc fb">4s</div>
        </div>
        <div class="dot d1"></div><div class="dot d2"></div><div class="dot d3"></div>
        <span class="lbl l1">N 40.4168°</span>
        <span class="lbl l2">commerce</span>
        <span class="lbl l3">W 3.7038°</span>
      </div>
    </div>
    <div class="hscroll"><div class="line"></div><span>scroll</span></div>
  </div>

  <!-- MARQUEE -->
  <div class="marq">
    <div class="mlbl">Confían en nosotros</div>
    <div class="mtrack">
      <span>NOURA</span><span>VELDT</span><span>KRAIM</span><span>SOLEIL</span><span>ORBIS</span><span>MAREN</span><span>FLUX</span><span>DEVA</span>
      <span>NOURA</span><span>VELDT</span><span>KRAIM</span><span>SOLEIL</span><span>ORBIS</span><span>MAREN</span><span>FLUX</span><span>DEVA</span>
    </div>
  </div>

  <!-- METRICS -->
  <section class="sec wrap">
    <div class="reveal"><div class="eyebrow">Por los números</div><h2 style="margin-top:20px;max-width:18ch;">El trabajo se mide. Aquí están los datos.</h2></div>
    <div class="metrics reveal d1" style="margin-top:60px;">
      <div class="metric"><div class="num"><span class="a">+€</span><span class="cnt" data-to="40">0</span><span class="a">M</span></div><div class="lbl">GMV generado para nuestros clientes en los últimos 24 meses.</div></div>
      <div class="metric"><div class="num"><span class="a">+</span><span class="cnt" data-to="120">0</span></div><div class="lbl">Proyectos Shopify lanzados desde 2020.</div></div>
      <div class="metric"><div class="num"><span class="cnt" data-to="4.9" data-dec="1">0</span><span class="a">★</span></div><div class="lbl">Satisfacción media sobre 89 reviews verificadas.</div></div>
    </div>
  </section>

  <!-- SERVICES -->
  <section class="sec wrap">
    <div class="sechead reveal">
      <div><div class="eyebrow">Servicios</div><h2 style="margin-top:20px;max-width:14ch;">Lo que hacemos, de principio a fin.</h2></div>
      <p>Cinco disciplinas, un único objetivo: que tu tienda venda más, mejor y con menos fricción.</p>
    </div>
    <div class="svcg">
      <article class="svcc big reveal"><a href="/servicios/desarrollo" style="display:contents"><div class="top"><span class="n">01 — Desarrollo</span><span class="ar">↗</span></div><div><h3>Desarrollo Shopify a medida.</h3><p class="desc">Themes, apps y soluciones Liquid / Hydrogen construidas para tu modelo de negocio.</p></div></a></article>
      <article class="svcc med reveal d1"><a href="/servicios/consultoria" style="display:contents"><div class="top"><span class="n">02 — Consultoría 360</span><span class="ar">↗</span></div><div><h3>CRO, UX y analítica.</h3><p class="desc">Decisiones orientadas a conversión. Research, experimentación y dashboards que importan.</p></div></a></article>
      <article class="svcc med reveal d2"><a href="/servicios/growth" style="display:contents"><div class="top"><span class="n">03 — Growth</span><span class="ar">↗</span></div><div><h3>Performance que escala.</h3><p class="desc">Paid media, email, retención y LTV. Canales conectados a un único P&amp;L.</p></div></a></article>
      <article class="svcc sm reveal d1"><a href="/servicios/migraciones" style="display:contents"><div class="top"><span class="n">04 — Migraciones</span><span class="ar">↗</span></div><div><h3>Migraciones.</h3><p class="desc">De cualquier plataforma a Shopify. Cero pérdidas de SEO ni ingresos.</p></div></a></article>
      <article class="svcc sm reveal d2"><a href="/servicios/plus" style="display:contents"><div class="top"><span class="n">05 — Shopify Plus</span><span class="ar">↗</span></div><div><h3>Shopify Plus.</h3><p class="desc">Para marcas que necesitan más potencia, control y automatización enterprise.</p></div></a></article>
      <article class="svcc sm reveal d3" style="background:transparent;border-style:dashed;"><a href="/contacto" style="display:contents"><div class="top"><span class="n">— Pregunta</span></div><div><h3 style="color:var(--muted-2);">¿No sabes cuál necesitas?</h3><p class="desc" style="max-height:120px;color:var(--lime);">Te ayudamos a decidirlo en 30 minutos. →</p></div></a></article>
    </div>
  </section>

  <!-- FEATURED CASE -->
  <section class="sec wrap">
    <div class="sechead reveal">
      <div><div class="eyebrow">Caso destacado</div><h2 style="margin-top:20px;">NOURA — Skincare</h2></div>
      <p>De WooCommerce de 6 cifras a Shopify Plus de 7 cifras en 11 meses. Sin rehacer el brand.</p>
    </div>
    <div class="fcase reveal d1">
      <div class="mock">
        <div class="mbar"><div class="dots"><i></i><i></i><i></i></div>noura.co</div>
        <div class="mbody" data-wm="NOURA"><div class="mhero"><div><h5>Ritual de mañana</h5><p>Colección cápsula · 4 refs</p><div class="mbtn">Comprar set →</div></div><div></div></div></div>
      </div>
      <div>
        <div class="cstat"><span class="v">+312%</span><span class="l">Tasa de conversión vs. baseline Woo</span></div>
        <div class="cstat"><span class="v">−40%</span><span class="l">Tiempo de carga LCP</span></div>
        <div class="cstat"><span class="v">×2.8</span><span class="l">ROAS blended paid media</span></div>
        <blockquote class="cq">&ldquo;4sens no nos dio un theme. Nos dieron una operación de commerce. Entendieron el unit economics antes de abrir Figma.&rdquo;<cite><b>Ana Márquez</b> — Founder, NOURA</cite></blockquote>
        <a class="tlink" href="/casos/noura" style="margin-top:24px;display:inline-flex;">Ver caso completo <span class="arr">→</span></a>
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="sec wrap">
    <div class="sechead reveal">
      <div><div class="eyebrow">Proceso</div><h2 style="margin-top:20px;max-width:16ch;">Cinco pasos. Ninguno opcional.</h2></div>
      <p>Un sistema probado en +120 proyectos: mide, decide, ejecuta, escala.</p>
    </div>
    <div class="process reveal d1" id="proc">
      <div class="pline"></div>
      <div class="step"><div class="c">01</div><h4>Auditoría</h4><p>Análisis técnico, analítico y de marca. Encontramos la grieta más grande.</p></div>
      <div class="step"><div class="c">02</div><h4>Estrategia</h4><p>Roadmap de 90 días con hipótesis priorizadas por ICE y revenue impact.</p></div>
      <div class="step"><div class="c">03</div><h4>Diseño</h4><p>UX y visual sobre un sistema modular. Prototipos que ya testean conversión.</p></div>
      <div class="step"><div class="c">04</div><h4>Desarrollo</h4><p>Liquid, Hydrogen, apps custom y stack analítico. Tiempo de carga bajo 1.2s.</p></div>
      <div class="step"><div class="c">05</div><h4>Escala</h4><p>Growth, retención y experimentación continua. El lanzamiento no es el final.</p></div>
    </div>
  </section>

  <CTA heading="¿Lista tu marca para escalar?" sub="Respondemos en menos de 24 horas con un plan inicial y un rango de presupuesto realista." label="Iniciar proyecto"/>
</BaseLayout>
