---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — Página no encontrada | 4sens Agency"
  description="Esta página no existe. Tu tienda Shopify sí debería."
>
  <div class="err">
    <div class="enum">404</div>
    <div class="einner wrap">
      <div class="eyebrow">Error · 404</div>
      <h1 style="margin-top:20px;max-width:20ch;">Esta página no existe. Tu tienda Shopify sí debería.</h1>
      <p class="lead" style="margin-top:26px;max-width:54ch;">Puede que el enlace esté roto, o que hayamos retirado la página.</p>
      <div style="display:flex;flex-wrap:wrap;gap:14px;margin-top:36px;">
        <a class="btn btn-p" href="/">Ir al home <span class="arr">→</span></a>
        <a class="btn btn-g" href="/casos">Ver casos</a>
        <a class="btn btn-g" href="/contacto">Contacto</a>
      </div>
    </div>
  </div>
</BaseLayout>
