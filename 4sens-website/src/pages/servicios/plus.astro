---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CTA from '../../components/CTA.astro';
---

<BaseLayout
  title="Shopify Plus — Implementación y Escalado Enterprise"
  description="Implementación y escalado de Shopify Plus. B2B, multistore internacional, Functions, Launchpad y checkout extensibility para marcas enterprise."
>
  <div class="phead wrap">
    <div class="eyebrow reveal">05 — Shopify Plus</div>
    <h1 class="reveal d1" style="margin-top:20px;">Para marcas que han superado los límites.</h1>
    <p class="lead reveal d2">Plus no es Shopify con más apps. Es otra categoría: más potencia, más control, más automatización.</p>
  </div>

  <section class="sec wrap">
    <div class="sechead reveal"><div><div class="eyebrow">Shopify vs. Plus</div><h2 style="margin-top:20px;">Cuándo el salto vale la pena.</h2></div></div>
    <table class="cmp reveal d1">
      <thead><tr><th>Feature</th><th>Shopify</th><th>Shopify Plus</th></tr></thead>
      <tbody>
        <tr><td>Checkout extensibility</td><td>Limitada</td><td class="y">Completa + UI extensions</td></tr>
        <tr><td>Scripts &amp; Functions</td><td class="n">—</td><td class="y">Incluido</td></tr>
        <tr><td>Launchpad</td><td class="n">—</td><td class="y">Incluido</td></tr>
        <tr><td>B2B nativo</td><td>Básico</td><td class="y">Catálogos, precios, límites</td></tr>
        <tr><td>Multistore</td><td>Manual</td><td class="y">Hasta 9 stores</td></tr>
        <tr><td>API rate limit</td><td>2 req/s</td><td class="y">8 req/s</td></tr>
        <tr><td>Staff accounts</td><td>5–15</td><td class="y">Ilimitados</td></tr>
      </tbody>
    </table>
  </section>

  <section class="sec wrap">
    <div class="sechead reveal"><div><div class="eyebrow">Casos de uso</div><h2 style="margin-top:20px;">Dónde Plus resuelve.</h2></div></div>
    <div class="grid-4 reveal d1">
      <div class="card"><h4>B2B</h4><p class="muted" style="margin-top:12px;">Catálogos privados, net 30, pedidos recurrentes, portales wholesale.</p></div>
      <div class="card"><h4>Internacional</h4><p class="muted" style="margin-top:12px;">Markets con precios locales, duty-inclusive y translations automáticas.</p></div>
      <div class="card"><h4>Automatización</h4><p class="muted" style="margin-top:12px;">Flow + Functions para backoffice sin tocar código.</p></div>
      <div class="card"><h4>Multistore</h4><p class="muted" style="margin-top:12px;">Marca principal + outlets + B2B + regionales desde un admin.</p></div>
    </div>
  </section>

  <section class="sec wrap">
    <blockquote class="cq reveal" style="border-top:0;padding-top:0;font-size:clamp(22px,2.4vw,32px);max-width:900px;">&ldquo;Pasamos de 3 desarrolladores de mantenimiento a una plataforma que se autogestiona. El ROI del upgrade a Plus lo vimos en el trimestre.&rdquo;<cite style="margin-top:22px;"><b>Lucas Prieto</b> — VP Digital, ORBIS Home</cite></blockquote>
  </section>

  <CTA heading="¿Estás en Plus o planteándotelo?" sub="Audit gratuita + modelo de ROI del upgrade en 48h." label="Hablar con un Plus expert"/>
</BaseLayout>
