---
import BaseLayout from '../layouts/BaseLayout.astro';
import CTA from '../components/CTA.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "provider": { "@type": "Organization", "name": "4sens Agency", "url": "https://4sens.io" },
  "name": "Servicios Shopify",
  "description": "Desarrollo Shopify, consultoría CRO, growth, migraciones y Shopify Plus.",
  "areaServed": ["ES", "PT", "FR", "IT", "GB"]
};
---

<BaseLayout
  title="Servicios Shopify — Desarrollo, CRO, Growth y Migraciones"
  description="Desarrollo Shopify a medida, consultoría CRO, growth & performance, migraciones y Shopify Plus. Cinco prácticas orientadas a resultados medibles."
  hasInteractions={true}
  schema={schema}
>
  <div class="phead wrap">
    <div class="eyebrow reveal">Servicios</div>
    <h1 class="reveal d1" style="margin-top:20px;">Lo que hacemos, y por qué importa.</h1>
    <p class="lead reveal d2">Cinco prácticas, una misma vara de medir: mover tus KPIs. Abre cualquier servicio para ver entregables y proceso.</p>
  </div>

  <section class="sec wrap">
    <div class="acc">
      <div class="accit"><button class="acch">01 — Desarrollo Shopify<span class="plus">+</span></button><div class="accb"><div class="accbi"><p>Themes 2.0, apps privadas y arquitecturas headless en Hydrogen. Código que tu equipo podrá mantener en tres años sin reescribir.</p><ul><li>Themes custom</li><li>Apps Remix + Polaris</li><li>Hydrogen / Oxygen</li><li>Integraciones ERP/PIM</li></ul><a class="btn btn-p" href="/servicios/desarrollo" style="margin-top:24px;display:inline-flex;">Ver servicio <span class="arr">→</span></a></div></div></div>
      <div class="accit"><button class="acch">02 — Consultoría 360 (CRO + UX + Data)<span class="plus">+</span></button><div class="accb"><div class="accbi"><p>Auditorías de conversión, research de usuarios, framework de experimentación y dashboards que te dicen qué hacer, no solo qué pasó.</p><ul><li>A/B testing</li><li>User research</li><li>GA4 + Looker Studio</li><li>PXL / ICE scoring</li></ul><a class="btn btn-p" href="/servicios/consultoria" style="margin-top:24px;display:inline-flex;">Ver servicio <span class="arr">→</span></a></div></div></div>
      <div class="accit"><button class="acch">03 — Growth &amp; Performance<span class="plus">+</span></button><div class="accb"><div class="accbi"><p>Paid media, lifecycle y retención bajo un modelo de atribución unificado. Cada euro invertido se rastrea hasta el pedido.</p><ul><li>Meta / Google / TikTok</li><li>Klaviyo flows</li><li>Loyalty &amp; subscription</li><li>LTV modeling</li></ul><a class="btn btn-p" href="/servicios/growth" style="margin-top:24px;display:inline-flex;">Ver servicio <span class="arr">→</span></a></div></div></div>
      <div class="accit"><button class="acch">04 — Migraciones<span class="plus">+</span></button><div class="accb"><div class="accbi"><p>De WooCommerce, Magento, PrestaShop o plataforma custom a Shopify. Zero downtime, SEO preservado, historial completo.</p><ul><li>Data mapping</li><li>Redirects 301</li><li>QA de checkout</li><li>Monitoring 30d</li></ul><a class="btn btn-p" href="/servicios/migraciones" style="margin-top:24px;display:inline-flex;">Ver servicio <span class="arr">→</span></a></div></div></div>
      <div class="accit"><button class="acch">05 — Shopify Plus<span class="plus">+</span></button><div class="accb"><div class="accbi"><p>Implementación y escalado de Plus. B2B, multistore internacional, Functions, Launchpad y checkout extensibility.</p><ul><li>B2B catalogs</li><li>Markets / Multistore</li><li>Scripts → Functions</li><li>Flow automation</li></ul><a class="btn btn-p" href="/servicios/plus" style="margin-top:24px;display:inline-flex;">Ver servicio <span class="arr">→</span></a></div></div></div>
    </div>
  </section>

  <section class="sec wrap">
    <div class="sechead reveal"><div><div class="eyebrow">Stack</div><h2 style="margin-top:20px;">Tecnologías con las que trabajamos.</h2></div><p>Herramientas elegidas por rendimiento, no por moda.</p></div>
    <div class="tag-row reveal d1">
      <span class="tag solid">Shopify</span><span class="tag solid">Shopify Plus</span><span class="tag solid">Liquid</span><span class="tag solid">Hydrogen</span><span class="tag solid">Oxygen</span><span class="tag solid">Storefront API</span><span class="tag solid">Admin API</span><span class="tag solid">Klaviyo</span><span class="tag solid">GA4</span><span class="tag solid">Looker Studio</span><span class="tag solid">Meta Ads</span><span class="tag solid">Google Ads</span><span class="tag solid">TikTok Ads</span><span class="tag solid">Hotjar</span><span class="tag solid">Segment</span><span class="tag solid">Contentful</span>
    </div>
  </section>

  <CTA heading="Cuéntanos tu caso." sub="Te diremos en menos de 24h qué servicio (o combinación) encaja." label="Iniciar proyecto"/>
</BaseLayout>
