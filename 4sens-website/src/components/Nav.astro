---
const path = Astro.url.pathname;
function isActive(href: string) {
  if (href === '/') return path === '/';
  return path.startsWith(href);
}
---

<nav class="nav" id="nav">
  <div class="navi">
    <a class="logo" href="/">
      <b>4sens</b><em>·</em><span>Agency</span>
    </a>
    <div class="nlinks">
      <a href="/servicios" class={isActive('/servicios') ? 'active' : ''}>Servicios</a>
      <a href="/casos" class={isActive('/casos') ? 'active' : ''}>Casos</a>
      <a href="/blog" class={isActive('/blog') ? 'active' : ''}>Blog</a>
      <a href="/nosotros" class={isActive('/nosotros') ? 'active' : ''}>Nosotros</a>
      <a href="/contacto" class={isActive('/contacto') ? 'active' : ''}>Contacto</a>
    </div>
    <button class="ham" id="ham" aria-label="Menú"><span></span></button>
  </div>
</nav>

<div class="mmenu" id="mmenu">
  <a href="/">Home</a>
  <a href="/servicios">Servicios</a>
  <a href="/casos">Casos</a>
  <a href="/blog">Blog</a>
  <a href="/nosotros">Nosotros</a>
  <a href="/recursos">Recursos</a>
  <a href="/testimonios">Testimonios</a>
  <a href="/contacto">Contacto</a>
</div>
